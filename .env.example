NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://holdfast:holdfast@localhost:5432/holdfast
SESSION_SECRET=replace-with-at-least-32-random-characters

# PayPal — sandbox only
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_SKIP_VERIFY=false
WORKER_DISABLED=false
PAYOUTS_ENABLED=false
EVIDENCE_ALLOWED_HOSTS=
ADMIN_EMAILS=

# AI — AI_PROVIDER is "anthropic", "gemini" (free tier via Google AI Studio, project-dependent) or "openrouter" (free ":free" models, 50 requests/day)
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=5
AI_INPUT_PRICE_USD_PER_MTOK=4
AI_OUTPUT_PRICE_USD_PER_MTOK=20
AI_MODE=replay

# Isolated local demo identities
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@holdfast.demo
LOG_LEVEL=info
